{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentApplication": {
    "UserAuthorization": {
      "DefaultHandlerName": "teamsSso",
      "AutoSignIn": true,
      "Handlers": {
        "teamsSso": {
          "Settings": {
            "AzureBotOAuthConnectionName": "teams-sso"
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "FederatedCredentials",
        "TenantId": "<tenant-id>",
        "ClientId": "<bot-app-client-id>",
        "FederatedClientId": "<bot-managed-identity-client-id>",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },
  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ],
  "Bot": {
    "Channel": {
      "ValidAudiences": [ "<bot-app-client-id>" ]
    },
    "Auth": {
      "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
      "ValidIssuers": [ "https://login.microsoftonline.com/<tenant-id>/v2.0" ],
      "ValidAudiences": [ "api://botid-<bot-app-client-id>", "<bot-app-client-id>" ]
    },
    "Obo": {
      "TenantId": "<tenant-id>",
      "ClientId": "<bot-app-client-id>",
      "ManagedIdentityClientId": "<bot-managed-identity-client-id>",
      "ZavaApiScopes": [ "api://zava-credit-union-api-<zava-api-app-client-id>/.default" ],
      "SearchScopes": [ "https://search.azure.com/.default" ]
    },
    "Foundry": {
      "SharePointRetrievalAgent": { "Name": "SharePointRetrievalAgent", "Version": "" },
      "ZavaApiAgent": { "Name": "ZavaApiAgent", "Version": "" },
      "ProjectEndpoint": "https://<foundry-account>.services.ai.azure.com/api/projects/<project>",
      "KnowledgeAgent": {
        "AgentName": "SharePointKnowledgeAgent",
        "ModelDeployment": "gpt-5.6-sol",
        "ProjectConnectionName": "compass-knowledge-base",
        "KnowledgeBaseMcpEndpoint": "https://<search-service>.search.windows.net/knowledgebases/zava-kb/mcp?api-version=2026-08-01-preview"
      }
    },
    "Members": {
      "ByObjectId": {}
    },
    "SharePoint": {
      "Route": "KnowledgeBase"
    },
    "FrontDoor": {
      "Enabled": true
    }
  }
}
